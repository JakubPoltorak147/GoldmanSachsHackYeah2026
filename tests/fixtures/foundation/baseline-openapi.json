{
  "components": {
    "schemas": {
      "Action": {
        "enum": [
          "ALLOW",
          "REDACT",
          "BLOCK"
        ],
        "title": "Action",
        "type": "string"
      },
      "DecisionResponse": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "finding_codes": {
            "items": {
              "const": "pii.email",
              "type": "string"
            },
            "title": "Finding Codes",
            "type": "array"
          },
          "interaction_id": {
            "format": "uuid",
            "title": "Interaction Id",
            "type": "string"
          },
          "reason_code": {
            "enum": [
              "no_findings",
              "policy_resolved"
            ],
            "title": "Reason Code",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EchoResult"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "interaction_id",
          "action",
          "reason_code",
          "finding_codes"
        ],
        "title": "DecisionResponse",
        "type": "object"
      },
      "EchoResult": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "title": "EchoResult",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InteractionRequest": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 16384,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "target_id": {
            "const": "local-echo",
            "title": "Target Id",
            "type": "string"
          }
        },
        "required": [
          "target_id",
          "content"
        ],
        "title": "InteractionRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/interactions": {
      "post": {
        "operationId": "interact_v1_interactions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InteractionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Interact"
      }
    }
  }
}
